# Everything in one image: XFCE + TigerVNC + websockify + this web client.
#
# Built on top of clouddesktop-desktop rather than from ubuntu:24.04, so the
# ~1.5 GB desktop layer is reused instead of re-downloaded and re-installed on
# every build. Only Node.js and the application code are added here.
#
# The base is pinned per run by BASE_IMAGE. The workflow passes the
# clouddesktop-desktop tag this same commit produced, never a moving tag like
# `latest`, so a build can never pick up a base from a different commit.
#
# Local builds need the base present first:
#   docker pull ghcr.io/feavy/clouddesktop-desktop:latest
#   docker build -f Dockerfile.full \
#     --build-arg BASE_IMAGE=ghcr.io/feavy/clouddesktop-desktop:latest .
ARG BASE_IMAGE=ghcr.io/feavy/clouddesktop-desktop:latest
FROM ${BASE_IMAGE}

# The desktop image ends as USER ubuntu; package installs need root.
USER root

ENV DEBIAN_FRONTEND=noninteractive

# install.sh is re-run here only to add Node.js. Every XFCE, TigerVNC and X
# tool package is already present in the base, so apt has nothing to download
# and this costs seconds rather than the several minutes a from-scratch build
# spends on the desktop. Keeping the call means install.sh stays the single
# source of truth for the package set.
#
# DESKTOP_USER is already an ENV in the base image (Dockerfile.desktop), so it
# is inherited and reused here -- an ARG of the same name would be shadowed by
# it. The fallback only matters for a base built before that ENV existed.
COPY install.sh /tmp/install.sh
RUN DESKTOP_USER="${DESKTOP_USER:-ubuntu}" bash /tmp/install.sh && rm -f /tmp/install.sh

# The web client itself
WORKDIR /app
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY client ./client
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint
COPY deploy/persist-entry.sh /usr/local/bin/persist-entry
COPY deploy/pivot-root.sh /usr/local/bin/pivot-root
COPY deploy/delta-persist.py /usr/local/lib/clouddesktop/delta-persist.py
RUN chmod +x /usr/local/bin/entrypoint /usr/local/bin/persist-entry \
       /usr/local/bin/pivot-root /usr/local/lib/clouddesktop/delta-persist.py

# Bake the cache-busting version and the build timestamp into the client.
# CI passes GITHUB_RUN_NUMBER and the commit time; local builds fall back to
# a client content hash and the stamping moment (see the script). Changing
# either arg invalidates this layer and everything after it.
COPY scripts/stamp-cache-version.sh /tmp/stamp-cache-version.sh
ARG CACHE_VERSION=dev
ARG BUILD_DATETIME
RUN CACHE_VERSION=${CACHE_VERSION} BUILD_DATETIME=${BUILD_DATETIME} sh /tmp/stamp-cache-version.sh /app/client \
    && rm -f /tmp/stamp-cache-version.sh

# Regenerate the delta baseline after /app and the stamped client are in place.
# The base image already has one for the desktop layer, but this image adds
# Node, the server and the client, so its index has to describe that final
# filesystem. Delta mode stores only paths that differ from this index.
RUN install -d /usr/local/share/clouddesktop \
    && python3 /usr/local/lib/clouddesktop/delta-persist.py baseline \
         --output /usr/local/share/clouddesktop/delta-baseline.json.gz

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    DISPLAY=:1 \
    VNC_HOST=127.0.0.1 \
    VNC_PORT=5900 \
    DESKTOP_USER=${DESKTOP_USER:-ubuntu}

# HOME is not set here on purpose: entrypoint.sh derives it from the passwd
# entry, so DESKTOP_USER stays the single place that decides which user we run
# as and the web client's file paths follow automatically.

# 3000 = web client, 6900 = websockify
EXPOSE 3000 6900

# The start period leaves room for start-vnc's startup work on a fresh
# container, chiefly generating the session locale when LANG/LC_ALL names one
# that is not baked in.
HEALTHCHECK --interval=30s --timeout=3s --start-period=120s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Unprivileged, and deliberately the same user as the desktop: the web client
# shells out to xclip/wmctrl/xrandr against the same X display, and reads the
# .Xauthority that Xtigervnc wrote. Same uid, so that works.
USER ubuntu

# persist-entry is a pass-through when no persistence variable is set. delta
# keeps only changed files on a PVC (root user only, no extra capabilities);
# full keeps the pivot_root(2) whole-root copy and needs the capabilities
# deploy/pivot-root.sh documents. With PERSIST_MODE unset, ROOT_PERSIST_DIR
# still selects full and PERSIST_DIR selects delta. tini reaps the X, dbus and
# websockify children the launcher forks.
ENTRYPOINT ["/usr/local/bin/persist-entry"]
CMD ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]