{
  "name": "Desktop",
  "short_name": "Desktop",
  "description": "Browser-based desktop for a remote XFCE session.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "fullscreen"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#1c1c1e",
  "categories": ["utilities", "productivity"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    { "src": "/icon-192.svg?cv=%CACHE_VERSION%", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-512.svg?cv=%CACHE_VERSION%", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png?cv=%CACHE_VERSION%", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png?cv=%CACHE_VERSION%", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}