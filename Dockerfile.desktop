# Desktop only: XFCE + TigerVNC + websockify, and nothing else.
#
# Use this when the web client runs as its own deployment or container
# (Dockerfile.client), pointed at the websockify port exposed here. It installs
# no Node.js, so the image stays considerably smaller than Dockerfile.full.
#
#   kubectl run ... ghcr.io/feavy/clouddesktop-desktop
#   the web client then sets WS_URL=wss://<this-host>/websockify
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    VNC_DISPLAY=:1 \
    VNC_PORT=5900 \
    VNC_WS_PORT=6900 \
    DISPLAY_GEOMETRY=1920x1080

# HOME is not set here on purpose: start-vnc derives it from the passwd entry,
# so DESKTOP_USER stays the single place that decides which user we run as.

# Space-separated extra locales to bake into the image, e.g. build with
# --build-arg EXTRA_LOCALES="fr_FR.UTF-8 de_DE.UTF-8". Only en_US.UTF-8 is
# generated otherwise; start-vnc also generates a missing locale on the fly
# when LANG/LC_ALL names one, so this is an optimization rather than a
# requirement.
ARG EXTRA_LOCALES=

# INSTALL_NODE=0 because the desktop does not need a JS runtime. Everything
# else -- including the xclip/wmctrl/xrandr/cvt tooling the web client shells
# out to -- is installed, so this image works unchanged if you later decide to
# run the client inside it.
COPY install.sh /tmp/install.sh
RUN INSTALL_NODE=0 EXTRA_LOCALES="${EXTRA_LOCALES}" bash /tmp/install.sh && rm -f /tmp/install.sh

# 6900 = websockify (the browser-facing port)
EXPOSE 6900

# Probes the websockify port rather than just the binary's existence, so a
# container that has crashed X but is still running reports unhealthy.
# The long start period leaves room for start-vnc's startup work: generating
# the session locale and, on base images that dpkg-strip translation catalogs,
# an apt reinstall that can take a minute or two.
HEALTHCHECK --interval=30s --timeout=3s --start-period=300s --retries=3 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/${VNC_WS_PORT:-6900}' || exit 1

# Unprivileged. install.sh reuses the image's stock `ubuntu` user by default and
# gave it a writable $HOME for .Xauthority, ~/.vnc and D-Bus sockets;
# Xtigervnc and XFCE both refuse to work properly as root and would leave
# root-owned files behind.
USER ubuntu

# tini reaps the X, dbus and websockify children that start-desktop forks
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/start-desktop"]