# Web client only — the smallest image, roughly 150 MB.
#
# The desktop (XFCE + TigerVNC + websockify) is expected to run elsewhere:
# either in a pod you already have, or as the image built from
# ./Dockerfile.desktop. Point the client at it with the WS_URL environment
# variable. See README.md for the wiring.
FROM node:22-alpine

WORKDIR /app

# Install dependencies first so the layer caches across code changes
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev && npm cache clean --force

COPY server ./server
COPY client ./client

# Bake the cache-busting version and the build timestamp into the client.
# CI passes GITHUB_RUN_NUMBER and the commit time; local builds fall back to
# a client content hash and the stamping moment (see the script). Changing
# either arg invalidates this layer and everything after it.
COPY scripts/stamp-cache-version.sh /tmp/stamp-cache-version.sh
ARG CACHE_VERSION=dev
ARG BUILD_DATETIME
RUN CACHE_VERSION=${CACHE_VERSION} BUILD_DATETIME=${BUILD_DATETIME} sh /tmp/stamp-cache-version.sh /app/client \
    && rm -f /tmp/stamp-cache-version.sh

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

USER node

CMD ["node", "server/app.js"]