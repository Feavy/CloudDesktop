# Everything in one image: XFCE + TigerVNC + websockify + this web client.
#
# Built on top of clouddesktop-desktop rather than from ubuntu:24.04, so the
# ~1.5 GB desktop layer is reused instead of re-downloaded and re-installed on
# every build. Only Node.js and the application code are added here.
#
# The base is pinned per run by BASE_IMAGE. The workflow passes the
# clouddesktop-desktop tag this same commit produced, never a moving tag like
# `latest`, so a build can never pick up a base from a different commit.
#
# Local builds need the base present first:
#   docker pull ghcr.io/feavy/clouddesktop-desktop:latest
#   docker build -f Dockerfile.full \
#     --build-arg BASE_IMAGE=ghcr.io/feavy/clouddesktop-desktop:latest .
ARG BASE_IMAGE=ghcr.io/feavy/clouddesktop-desktop:latest
FROM ${BASE_IMAGE}

# The desktop image ends as USER ubuntu; package installs need root.
USER root

ENV DEBIAN_FRONTEND=noninteractive

# install.sh is re-run here only to add Node.js. Every XFCE, TigerVNC and X
# tool package is already present in the base, so apt has nothing to download
# and this costs seconds rather than the several minutes a from-scratch build
# spends on the desktop. Keeping the call means install.sh stays the single
# source of truth for the package set.
COPY install.sh /tmp/install.sh
RUN bash /tmp/install.sh && rm -f /tmp/install.sh

# The web client itself
WORKDIR /app
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY client ./client
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    DISPLAY=:1 \
    VNC_HOST=127.0.0.1 \
    VNC_PORT=5900

# HOME is not set here on purpose: entrypoint.sh derives it from the passwd
# entry, so DESKTOP_USER stays the single place that decides which user we run
# as and the web client's file paths follow automatically.

# 3000 = web client, 6900 = websockify
EXPOSE 3000 6900

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Unprivileged, and deliberately the same user as the desktop: the web client
# shells out to xclip/wmctrl/xrandr against the same X display, and reads the
# .Xauthority that Xtigervnc wrote. Same uid, so that works.
USER ubuntu

# tini reaps the X, dbus and websockify children that the launcher forks
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]