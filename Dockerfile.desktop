# Full desktop pod: XFCE + TigerVNC + websockify + this web client, all in
# one image. Use this when you do not already have a desktop pod.
#
# The lighter ./Dockerfile builds only the web client, for when XFCE/TigerVNC
# already run elsewhere.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    VNC_DISPLAY=:1 \
    VNC_PORT=5900 \
    VNC_WS_PORT=6900 \
    DISPLAY_GEOMETRY=1920x1080

# Every prerequisite the web client and the desktop need
COPY install.sh /tmp/install.sh
RUN bash /tmp/install.sh && rm -f /tmp/install.sh

# The web client itself
WORKDIR /app
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev && npm cache clean --force
COPY server ./server
COPY client ./client
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    DISPLAY=:1 \
    VNC_HOST=127.0.0.1 \
    VNC_PORT=5900

# 3000 = web client, 6900 = websockify
EXPOSE 3000 6900

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# tini reaps the X, dbus and websockify children that the launcher forks
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]